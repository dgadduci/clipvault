# Build artifacts
/target
**/target
**/*.rs.bk
# Tauri generated files
**/gen/schemas
app/tauri/src-tauri/gen

# Frontend
**/node_modules
**/dist
**/.svelte-kit
**/.vite

# Accidental package-manager files (we use npm and the tracked
# app/tauri/frontend/package-lock.json). The patterns match at any depth
# so an editor or one-off script that drops a pnpm lockfile does not
# pollute `git status`. Existing local files are left untouched.
/pnpm-lock.yaml
**/pnpm-lock.yaml
**/pnpm-workspace.yaml

# IDE
.vscode
.idea
*.swp
.DS_Store

# Local runtime data
.clipvault

# Local agent/tooling state
/.codex/
/.opencode/node_modules/
/.opencode/package.json
/.opencode/package-lock.json

# Local databases and runtime logs
*.db
*.sqlite
*.sqlite3
*.log

# Local secrets and environment overrides
.env
.env.*
!.env.example
