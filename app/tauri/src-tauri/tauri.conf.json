{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "0.0.20",
  "identifier": "com.clipvault.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 1080,
        "height": 460,
        "minWidth": 720,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "startup-splash",
        "title": "ClipVault",
        "url": "index.html",
        "width": 360,
        "height": 300,
        "backgroundColor": "#0e1116",
        "resizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "quick-paste",
        "title": "ClipVault Quick Paste",
        "url": "quick-paste.html",
        "width": 720,
        "height": 520,
        "minWidth": 720,
        "minHeight": 520,
        "maxWidth": 720,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/gnome-extension/metadata.json",
      "resources/gnome-extension/extension.js",
      "resources/kde-kwin-script/metadata.json",
      "resources/kde-kwin-script/contents/code/main.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "macos/Info.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMEUxNDIyM0VFQjQyRTUKUldUbFF1cytJaFFPWFA1eHY1N0xmSUhrV2ZlUlBRRXFUNlBxVzhtK2dLNDEzZFQ1Rk4vL3FGS28K",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/dgadduci/clipvault/releases/latest/download/latest.json"
      ]
    }
  }
}
