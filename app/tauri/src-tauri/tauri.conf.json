{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "0.0.6",
  "identifier": "com.clipvault.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 1080,
        "height": 460,
        "minWidth": 720,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "quick-paste",
        "title": "ClipVault Quick Paste",
        "url": "quick-paste.html",
        "width": 720,
        "height": 520,
        "minWidth": 720,
        "minHeight": 520,
        "maxWidth": 720,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
