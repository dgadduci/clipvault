{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "application-updates",
  "description": "Allow the main ClipVault window to check, install and relaunch signed application updates",
  "windows": ["main"],
  "permissions": [
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
