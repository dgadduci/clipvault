{
  "name": "clipvault-frontend",
  "private": true,
  "version": "0.0.20",
  "type": "module",
  "description": "Svelte + TypeScript frontend for the ClipVault desktop shell",
  "scripts": {
    "dev": "vite",
    "build": "npm run locales:check && svelte-check --tsconfig ./tsconfig.json && vite build",
    "locales:check": "node scripts/validate-locales.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsc --noCheck -p tsconfig.test.json && node --test --test-reporter=spec test-build/tests/*.test.js"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-process": "2.2.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "highlight.js": "^11.10.0",
    "svelte-awesome-color-picker": "^4.1.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  }
}
